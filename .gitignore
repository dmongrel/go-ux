# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# ...except the vendored winpty binaries terminal/winpty_windows.go embeds
# via go:embed — these are source, not build output.
!terminal/winpty/winpty.dll
!terminal/winpty/winpty-agent.exe

# Built server binary (bare, no extension)
/epub-novel-mcp-server

# Test binaries
*_test

# Output of 'go build'
*.out

# Dependency directories
vendor/
dist/
node_modules/

# Wails-generated JS/TS bindings (regenerated by `wails3 build`/`wails3
# generate bindings`, not source)
/uxdemo/frontend/bindings/

# Task (https://taskfile.dev) checksum cache — wails3 build's task runner,
# not source
/uxdemo/.task/

# Go module cache
.cache/go-build/

# IDE specific files
.idea/
.junie/
.vscode/
.ai/
.claude/
*.swp
*.bak
*.swo

# Log files
logs/
*.log

# Environment variables
.env
.env.*


# OS generated files
.DS_Store
Thumbs.db
/test_fdx/
/tests/
/.artifacts/

# Full-resolution parchment originals, kept locally for review only —
# the shipped versions under reader/parchment_images/ are downscaled.
/reader/parchment_images_bak/
